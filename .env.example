OPENAI_API_KEY=sk-...
ELEVENLABS_API_KEY=...

# Optional — all have working defaults.
# Verify model names on event morning with: curl localhost:3000/api/models
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=
OPENAI_STT_MODEL=whisper-1
OPENAI_MODERATION_MODEL=omni-moderation-latest

ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_multilingual_v2

# Upstream deadline in ms — stops a hung API call from freezing a demo.
REQUEST_TIMEOUT_MS=60000

# Only needed for a proxy, a regional endpoint, or a local mock.
# OPENAI_BASE_URL=https://api.openai.com/v1
# ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1
