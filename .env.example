# Copy this file to .env.local and fill in the two values from your Supabase project:
#   Supabase dashboard -> Project Settings -> API
#
# .env.local is gitignored. Never commit real keys.

# "Project URL" — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# "service_role" secret key — SERVER ONLY. It bypasses Row Level Security,
# so it must never be prefixed with NEXT_PUBLIC_ or imported into a "use client" file.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
